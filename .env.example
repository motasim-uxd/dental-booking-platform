# Copy to .env.local for local development.

# Postgres (docker compose postgres service)
DATABASE_URL=postgresql://dental:dental@localhost:5432/dental_booking

# Internal APIs (resolve-phone, future normalize-slot)
PLATFORM_INTERNAL_SECRET=

# Lex / Connect → POST /api/book (x-api-key header) + tenant availability
CONNECT_WEBHOOK_SECRET=

# Lex Lambda: fallback tenant when called DID is unknown
DEFAULT_TENANT_SLUG=smilesquad
# DEFAULT_CALLED_DID=+15551234567
# DEFAULT_PRACTICE_NAME=Smile Squad Pediatric Dentistry

# Web form preview gate (optional; per-tenant code in DB when web form add-on enabled)
WEB_FORM_PREVIEW_CODE=

# Optional: seed a DID for resolve-phone testing
# SEED_TENANT_PHONE_E164=+15551234567

# Legacy operatory overrides (used when DATABASE_URL unset; tenant JSON preferred)
# SMILE_SQUAD_BOOKING_OPERATORY_TREATMENT=4
# SMILE_SQUAD_BOOKING_OPERATORIES_BY_TYPE={"Cleaning":[6,2],"Emergency":[6,2],"Consultation":[3],"Treatment":[4]}
# SMILE_SQUAD_BOOKING_OPERATORY_LABELS={"6":"OP2","3":"OP3","4":"OP4"}

# Optional: public URL of your Whisper HTTP API (local dev only)
WHISPER_SERVER_URL=
